# IP alias and functions
alias ip="ifconfig -a | egrep -A 7 '^en0' | grep inet | grep -oE '((1?[0-9][0-9]?|2[0-4][0-9]|25[0-5])\.){3}(1?[0-9][0-9]?|2[0-4][0-9]|25[0-5])' | head -n 1"
alias pubip="curl -s http://checkip.amazonaws.com"

alias copy='tr -d "\n" | pbcopy'
alias pwdc='pwd | tr -d "\n" | pbcopy'

alias tree='tree --gitignore'
alias unlock-keychain='security unlock-keychain ~/Library/Keychains/login.keychain-db'

# Start tmux using iTerm2's native control-mode integration.
tmuxcc() {
  if [[ "$TERM_PROGRAM" != "iTerm.app" ]]; then
    echo "tmuxcc requires iTerm2." >&2
    return 1
  fi

  if [[ -n "$TMUX" ]]; then
    echo "tmuxcc cannot be started from inside another tmux client." >&2
    return 1
  fi

  command tmux -CC "$@"
}

alias dw='dotnet watch --no-hot-reload'
alias dws='dotnet watch --no-hot-reload --launch-profile https'
alias ssm-vpn='aws ssm start-session --target i-0a73cdc148fbc9b17'

_machine_number() {
  if [[ -n "$1" ]]; then
    echo "$1"
    return 0
  fi

  local machine_number
  machine_number=$(curl -s --connect-timeout 2 http://192.168.25.13:4001/info | jq -r '.machineNumber // empty')
  if [[ -z "$machine_number" || "$machine_number" == "null" ]]; then
    echo "Error: No machine number provided and could not fetch from http://192.168.25.13:4001/info" >&2
    return 1
  fi
  echo "$machine_number"
}

pn() {
  local machine_number
  machine_number=$(_machine_number "$1") || return 1
  pin "$machine_number" | awk -v ORS="" '{print $1}' | pbcopy
}

pw() {
  local machine_number
  machine_number=$(_machine_number "$1") || return 1
  pin "$machine_number" | awk -v ORS="" '{print $2}' | pbcopy
}

nmr() {
  if [[ $# -eq 0 ]]; then
    echo "Error: At least one machine number is required"
    echo "Usage: nmr <machine_number> [machine_number ...]"
    return 1
  fi
  
  for machine_number in "$@"; do
    local repo_name="vancebuild/${machine_number}_TwinCAT"
    local repo_url="https://github.com/${repo_name}"
    
    echo "Creating private repository: $repo_name"
    gh repo create "$repo_name" --private
    
    echo "Granting 'push' permission to the 'machines' team for repository: $repo_name"
    gh api --method PUT "/orgs/vancebuild/teams/machines/repos/$repo_name" -f permission=push
    
    echo "Repository '$repo_name' created and permissions set."
    echo "Click here to open the repository on GitHub: $repo_url"
    echo "---"  # Separator between repos for clarity
  done
}

msdb() {
  if [ -z "$1" ]; then
    echo "Usage: msdb <ConnectionName> [query]"
    return 1
  fi

  local SECRETS_ID
  SECRETS_ID=$(grep -o '<UserSecretsId>[^<]*' *.csproj 2>/dev/null | head -1 | sed 's/<UserSecretsId>//')

  if [ -z "$SECRETS_ID" ]; then
    echo "Error: No UserSecretsId found in any .csproj file in the current directory."
    return 1
  fi

  local SECRETS_FILE="$HOME/.microsoft/usersecrets/$SECRETS_ID/secrets.json"

  if [ ! -f "$SECRETS_FILE" ]; then
    echo "Error: Secrets file not found at $SECRETS_FILE"
    return 1
  fi

  local CONN
  CONN=$(jq -r ".ConnectionStrings[\"$1\"]" "$SECRETS_FILE")

  if [ -z "$CONN" ] || [ "$CONN" = "null" ]; then
    echo "Error: Connection string 'ConnectionStrings:$1' not found in secrets."
    return 1
  fi

  local SERVER DATABASE USER PASS

  SERVER=$(echo "$CONN" | sed -n 's/.*[Ss]erver=\([^;]*\).*/\1/p;s/.*[Dd]ata [Ss]ource=\([^;]*\).*/\1/p' | head -1)
  DATABASE=$(echo "$CONN" | sed -n 's/.*[Dd]atabase=\([^;]*\).*/\1/p;s/.*[Ii]nitial [Cc]atalog=\([^;]*\).*/\1/p' | head -1)
  USER=$(echo "$CONN" | sed -n 's/.*[Uu]ser [Ii]d=\([^;]*\).*/\1/p' | head -1)
  PASS=$(echo "$CONN" | sed -n 's/.*[Pp]assword=\([^;]*\).*/\1/p' | head -1)

  if [ -z "$SERVER" ] || [ -z "$DATABASE" ] || [ -z "$USER" ] || [ -z "$PASS" ]; then
    echo "Error: Could not parse all fields from connection string."
    echo "Connection string: $CONN"
    return 1
  fi

  if [ -n "$2" ]; then
    sqlcmd -S "$SERVER" -U "$USER" -P "$PASS" -d "$DATABASE" -Q "$2"
  else
    echo "Connecting to $DATABASE on $SERVER as $USER..."
    sqlcmd -S "$SERVER" -U "$USER" -P "$PASS" -d "$DATABASE"
  fi
}

# Docker dev environment aliases
alias devenv='docker run -it --rm -v $(pwd):/workspace dev-env'
alias devenvp='docker run -it --rm -p 3000:3000 -v $(pwd):/workspace dev-env'
